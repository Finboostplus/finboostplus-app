# Projeto FinBoostPlus Server - .gitignore

# Arquivos auxiliares de IDE e build
HELP.md

# Output de build Maven
/target/
!**/src/main/**/target/
!**/src/test/**/target/

# Wrapper Maven (DEVE ser commitado: mvnw, mvnw.cmd, maven-wrapper.properties, maven-wrapper.jar)
# Não ignorar o jar do wrapper

# Logs e dumps
*.log
hs_err_pid*.log
replay_pid*.log
*.hprof
*.dump

# IDEs
.apt_generated
.classpath
.factorypath
.project
.settings
.springBeans
.sts4-cache
.idea
*.iws
*.iml
*.ipr

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbdist/
/.nb-gradle/

# Gradle (caso venha a coexistir)
/build/
!**/src/main/**/build/
!**/src/test/**/build/

# VS Code
.vscode/

# SO / Diversos
.DS_Store
Thumbs.db

# Arquivos temporários
.tmp
~$*
*.swp

# Cobertura (mantida dentro de target já ignorado)
# jacoco.exec fica em target

# Ambiente / segredos (caso venha a existir)
*.env
.env.local
.env.*.local
