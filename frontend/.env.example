# ============================
# 🌐 CONFIGURAÇÕES DE AMBIENTE
# ============================

# URL base da API em desenvolvimento
VITE_BASEURL_DEV="{Endereço do banco de desenvolvimento}"

# URL base da API em produção
VITE_BASEURL_PROD="{Endereço do banco de produção}"

# Credenciais codificadas em Base64: "client_id:client_secret"
VITE_CLIENT_CREDENTIALS_BASE64="{Base64 das credênciais (client_id:client_secret)}"

# Chave de criptografia para SecureLS (AES-256)
VITE_SECURE_LS_ENCRYPTION_KEY=COLOQUE_SUA_CHAVE_AQUI